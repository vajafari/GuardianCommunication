		<!--<add key="ConnectionStringDevelop" value="Server=192.168.41.5; Initial Catalog=PadisCommunication; User ID=sa; Password=Msr@123456; MultipleActiveResultSets=True; Application Name=PadisComminication.Api;" />
		<add key="LogConnectionStringDevelop" value="Server=192.168.41.5; Initial Catalog=KarnamaLog; User ID=sa; Password=Msr@123456; MultipleActiveResultSets=True; Application Name=PadisComminication.Api;" />-->
		
		<add key="ConnectionStringDevelop" value="Server=.; Initial Catalog=PadisCommunication; User ID=sa; Password=master; MultipleActiveResultSets=True; Application Name=PadisComminication.Api;" />
		<add key="LogConnectionStringDevelop" value="Server=.; Initial Catalog=KarnamaLog; User ID=sa; Password=master; MultipleActiveResultSets=True; Application Name=PadisComminication.Api;" />
		
		<!--<add key="ConnectionStringDevelop" value="Server=.\SQL2022; Initial Catalog=PadisCommunication; User ID=sa; Password=master; MultipleActiveResultSets=True; Application Name=PadisComminication.Api;" />
		<add key="LogConnectionStringDevelop" value="Server=.\SQL2022; Initial Catalog=KarnamaLog; User ID=sa; Password=master; MultipleActiveResultSets=True; Application Name=PadisComminication.Api;" />-->

