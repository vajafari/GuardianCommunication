<?xml version="1.0" encoding="utf-8"?>
<configuration>

	<configSections>
		<section name="superSocket" type="SuperSocket.SocketEngine.Configuration.SocketServiceConfig, SuperSocket.SocketEngine" />
	</configSections>

	<superSocket>
		<servers>
			<server name="SecureSuperWebSocket" serverTypeName="SuperWebSocket" ip="Any" port="7788" mode="Tcp" minWorkingThreads="50" maxWorkingThreads="5000" maxCompletionPortThreads="10000" minCompletionPortThreads="1000" listenBacklog="10000" maxConnectionNumber="100000" maxRequestLength="2048000">
			</server>
		</servers>
		<serverTypes>
			<add name="SuperWebSocket" type="SuperWebSocket.WebSocketServer, SuperWebSocket" />
		</serverTypes>
	</superSocket>

	<appSettings>
		<add key="aspnet:UseTaskFriendlySynchronizationContext" value="true" />
		<add key="ClientSettingsProvider.ServiceUri" value="" />
		<add key="SqlCommandTimeout" value="60" />
		<add key="SqlCommandTimeoutLong" value="600" />
		<add key="LogLevelGeneral1" value="16386" />
		<add key="LogLevelKarnamaCall" value="0" />
		<add key="LogLevelSuprema1" value="0" />
		<add key="LogLevelSuprema2" value="0" />
		<add key="LogLevelVirdi" value="0" />
		<add key="LogLevelPw" value="0" />
		<add key="LogLevelTimy" value="0" />
		<add key="LogLevelElmoSanat" value="0" />
		<add key="LogLevelZk" value="0" />
		<add key="LogLevelPadisController" value="0" />
		<add key="LogLevelCamera" value="0" />
		<add key="LogLevelXRay" value="0" />
		<add key="LogLevelMetalDetector" value="0" />
		<add key="LogLevelPrintService" value="16" />
		<add key="IncludeStack" value="false" />
		<add key="ValidIpAddresses" value="" />
		<add key="ZkOpenDoorDelay" value="0" />
		<add key="IsXRayActive" value="true" />
		<add key="IsMetalDetectorGateActive" value="true" />
		<add key="SupremaSdkAccessGroupCode" value="" />
		<add key="SimultaneousZkServerThreadsCount" value="1" />
		<add key="ConnectionString" value="" />
		
